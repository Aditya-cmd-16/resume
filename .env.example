SESSION_SECRET=replace-with-a-random-32-character-or-longer-secret
PORT=8787
# Keep this value on the server only. Create an API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=replace-with-your-openai-api-key
# Optional. Use any JSON-capable OpenAI chat model available to your account.
OPENAI_MODEL=gpt-4o-mini

